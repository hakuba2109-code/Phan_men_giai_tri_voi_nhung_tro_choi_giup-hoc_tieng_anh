# Sao chép file này thành .env rồi điền giá trị thật. Không commit .env.

# Mật khẩu có chứa ký tự @ nên trong chuỗi kết nối phải mã hóa thành %40
DATABASE_URL=postgresql://postgres:MAT_KHAU%40@localhost:5432/gameEnglish
PORT=3000
NODE_ENV=development

# Bộ phân tích đề bằng AI (Gemini-compatible). Key không được commit — chỉ nằm trong .env
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Bỏ trống AI_URL để tự suy ra từ AI_MODEL, hoặc dán URL đầy đủ nếu key dùng endpoint khác
AI_URL=
# Số đợt gọi AI song song. Key miễn phí hay bị 429 (hết hạn mức) thì để 1
AI_PARALLEL=2
# on (mặc định) = khi file đề không có đáp án, gọi thêm một lượt AI TỰ GIẢI (schema
# riêng, ~300 token/câu) để có đáp án thật thay vì tạm chọn A. off = tắt lượt này.
AI_SOLVE=on

# --- Gia sư AI (dịch câu + dịch đáp án + vì sao loại đáp án sai, gọi lúc bấm đáp án) ---
# Số lượt gọi AI tối đa cho MỖI tài khoản trong MỘT ngày. Đặt 0 để tắt hẳn
# (những câu đã có bản dịch trong CSDL vẫn hiện bình thường, không tốn gì).
AI_COACH_DAILY=60
# Trần token ĐẦU RA của một lượt gọi; bản dịch + lý do ngắn nên 500 là đủ.
AI_COACH_MAX_TOKENS=500

# --- Bản dịch câu + đáp án trong khối 💡 ---
# Trần token đầu ra khi phải nhờ Gemini; đường miễn phí không dùng tới.
AI_TRANSLATE_MAX_TOKENS=320
# on (mặc định) = dịch máy miễn phí trước, không tốn lượt AI; off = chỉ dùng Gemini.
TRANSLATE_FREE=on

# --- Mê cung kho báu: khoá ký mã chứng chỉ (HMAC-SHA256) ---
# Chuỗi ngẫu nhiên >= 24 ký tự, chỉ nằm trong .env — KHÔNG commit, KHÔNG in ra log.
# Thiếu khoá này thì API /api/dungeon/finish trả 503 (ván giữ nguyên, không mất tiến độ).
CERT_SECRET=

# --- Tra cứu bôi đen (Alt+Z / Alt+X) + sổ từ ---
# Tầng 1 không bắt buộc khóa: từ điển miễn phí + Gemini ngắn. Nếu có khóa Google
# Cloud Translation chính thức (API key) thì dùng nó thay cho Gemini ở tầng 1.
GOOGLE_TRANSLATE_KEY=
# Số lượt phân tích sâu (tầng 2) tối đa cho MỖI tài khoản trong MỘT ngày (số dương).
# Trúng cache không tính lượt. Giảm xuống 1 để gần như chỉ dùng cache.
LOOKUP_DEEP_DAILY=60
# Số lần tra tầng 1 tối đa mỗi phút cho một tài khoản.
LOOKUP_RATE_PER_MIN=60
# Trần token đầu ra của một lượt phân tích sâu.
LOOKUP_DEEP_MAX_TOKENS=800
# (Chỉ dùng khi kiểm thử) Đường dẫn tới tệp từ dễ nhầm khác, ví dụ một JSON hỏng
# để kiểm server vẫn khởi động. Bỏ trống = dùng data/confusables.json.
LOOKUP_CONFUSABLES_PATH=
