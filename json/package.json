{
  "name": "toeic-tro-choi",
  "version": "1.0.0",
  "private": true,
  "description": "TOEIC Practice — web game ôn TOEIC Giai đoạn 1, ngân hàng câu hỏi trong PostgreSQL",
  "main": "../src/server.js",
  "scripts": {
    "start": "node ../src/server.js",
    "dev": "node --watch ../src/server.js",
    "ingest": "node ../scripts/ingest.js",
    "ai:import": "node ../scripts/ai-import.js",
    "ai:explain": "node ../scripts/ai-explain.js",
    "explain:free": "node ../scripts/explain-free.js",
    "ai:keycheck": "node ../scripts/ai-keycheck.js",
    "build": "node ../scripts/build.js",
    "test": "node ../scripts/test-parser.js && node ../scripts/test-ai-parser.js && node ../scripts/test-explainer.js && node ../scripts/test-skill-items.js && node ../scripts/test-dungeon.js && node ../scripts/test-dungeon-rules.js && node ../scripts/test-certificate.js && node ../scripts/test-town.js && node ../scripts/test-xu-moi.js && node ../scripts/test-island-core.js && node ../scripts/test-decor-core.js && node ../scripts/test-sakura.js && node ../scripts/test-lookup.js && node ../scripts/test-auth-ui.js && node ../scripts/test-landing.js",
    "verify": "npm test && node ../scripts/audit-free-explainer.js && node ../scripts/audit-skill-items.js",
    "audit:skills": "node ../scripts/audit-skill-items.js",
    "setup": "node ../scripts/ingest.js && node ../scripts/build.js",
    "test:dungeon-api": "node ../scripts/test-dungeon-api.js",
    "test:town-api": "node ../scripts/test-town-api.js",
    "test:xu-api": "node ../scripts/test-xu-api.js",
    "test:sakura-api": "node ../scripts/test-sakura-api.js",
    "test:island-api": "node ../scripts/test-island-api.js",
    "test:decor-api": "node ../scripts/test-decor-api.js",
    "test:xu-moi": "node ../scripts/test-xu-moi.js",
    "test:wallet": "node ../scripts/test-town-api.js && node ../scripts/test-xu-api.js && node ../scripts/test-sakura-api.js && node ../scripts/test-island-api.js && node ../scripts/test-decor-api.js",
    "town:sim": "node ../scripts/town-sim.js",
    "xu:sim": "node ../scripts/sim-xu-moi.js",
    "xu:sim:real": "node ../scripts/sim-xu-moi.js --db",
    "decor:sim": "node ../scripts/sim-trang-tri.js",
    "decor:sim:real": "node ../scripts/sim-trang-tri.js --db",
    "seed:3-dao": "node ../scripts/seed-tai-khoan-3-dao.js",
    "test:lookup-api": "node ../scripts/test-lookup-pg.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.9.5",
    "multer": "^2.0.2",
    "pg": "^8.16.3"
  }
}
